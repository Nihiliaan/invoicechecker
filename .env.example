# =================================================================
# 识别引擎选择 (OCR Provider)
# 可选值：
#   - zhipu:   智谱 GLM-4V-Flash 视觉多模态大模型（官方永久免费，全能支持各类专普票与客票，推荐）
#   - tencent: 腾讯云增值税发票识别（备选）
#   - aliyun:  阿里云百炼视觉大模型 (Qwen-VL)
#   - openai:  标准 OpenAI 兼容多模态接口（智谱/DeepSeek/Ollama本地等）
# =================================================================
OCR_PROVIDER=zhipu

# ── 智谱 AI 视觉多模态大模型配置（用于发票识别与验证码双图秒过，GLM-4V-Flash 永久免费）──
# 获取地址：https://bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# ── 腾讯云 OCR 配置（当 OCR_PROVIDER=tencent 时必填）──
# 获取地址：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=your_secret_id_here
TENCENTCLOUD_SECRET_KEY=your_secret_key_here
TENCENTCLOUD_REGION=ap-guangzhou

# ── 腾讯云混元大模型 / TokenHub 专用 API Key（备选）──
# 获取地址：https://console.cloud.tencent.com/hunyuan/start 或 https://console.cloud.tencent.com/tokenhub/apikey
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hy4-preview

# ── 阿里云百炼配置（当 OCR_PROVIDER=aliyun 时必填）──
# 获取地址：https://bailian.console.aliyun.com/
ALIBABA_API_KEY=your_alibaba_api_key_here
VLM_MODEL=qwen3-vl-flash

# ── OpenAI 兼容协议配置（当 OCR_PROVIDER=openai 时生效）──
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── 浏览器与自动化配置 ──
# 是否使用无头模式（Linux 服务器必须为 true）
HEADLESS=true

# Chromium 可执行文件路径（留空则自动探测系统路径或由 Playwright 自行管理）
# Linux 常见路径示例：/snap/bin/chromium 或 /usr/bin/chromium
# Windows 示例：C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_EXECUTABLE_PATH=

# CDP 远程调试连接地址（可选，如需连接外部 Chrome 调试实例时填写，如 http://localhost:9222）
CDP_URL=
