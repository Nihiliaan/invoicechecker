# =================================================================
# 识别引擎选择 (OCR Provider)
# 可选值：
#   - openai:  OpenAI 兼容接口（支持本地私有模型如 Ollama / vLLM 自定义端口，杜绝数据外发；亦支持第三方端点）
#   - zhipu:   智谱 GLM 开放平台
#   - aliyun:  阿里云百炼视觉模型 (Qwen-VL)
#   - tencent: 腾讯云增值税发票识别
# =================================================================
OCR_PROVIDER=openai

# ── 隐私与离线保护 ──
# 若设置为 true，系统将严格禁止将任何发票数据发送至公网第三方模型，仅使用本地二维码和正则解析
OFFLINE_ONLY=false

# ── 本地私有大模型 / OpenAI 兼容接口配置（当 OCR_PROVIDER=openai 时生效）──
# 场景 1：本地 Ollama 私有部署（推荐无外网数据外发需求的场景）
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5-vl:7b
#
# 场景 2：局域网 vLLM / LocalAI 私有端口
# OPENAI_BASE_URL=http://192.168.10.100:8000/v1
# OPENAI_API_KEY=none
# OPENAI_MODEL=Qwen2.5-VL-7B-Instruct
#
# 场景 3：外部公网 OpenAI 兼容服务
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── 智谱 AI 平台配置（当 OCR_PROVIDER=zhipu 时生效）──
ZHIPU_API_KEY=your_zhipu_api_key_here

# ── 腾讯云 OCR 配置（当 OCR_PROVIDER=tencent 时必填）──
TENCENTCLOUD_SECRET_ID=your_secret_id_here
TENCENTCLOUD_SECRET_KEY=your_secret_key_here
TENCENTCLOUD_REGION=ap-guangzhou

# ── 腾讯云混元大模型 / TokenHub 专用配置（备选）──
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hy4-preview

# ── 阿里云百炼配置（当 OCR_PROVIDER=aliyun 时必填）──
ALIBABA_API_KEY=your_alibaba_api_key_here
VLM_MODEL=qwen3-vl-flash

# ── 浏览器与自动化配置 ──
# 是否使用无头模式（服务器环境建议为 true）
HEADLESS=true

# Chromium 安全沙箱控制（默认以当前非 root 用户启用原生沙箱，仅在 root 容器环境自动回退）
CHROMIUM_NO_SANDBOX=false

# Chromium 可执行文件路径（留空则自动探测系统路径或由 Playwright 自行管理）
# Linux 常见路径示例：/snap/bin/chromium 或 /usr/bin/chromium
# Windows 示例：C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_EXECUTABLE_PATH=

# CDP 远程调试连接地址（可选，如需连接外部 Chrome 调试实例时填写，如 http://localhost:9222）
CDP_URL=
